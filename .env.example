# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repo.
# Valores de desarrollo local; en producción vienen de infra/.env en la EC2.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cuymonitor
DB_USER=cuymonitor
DB_PASSWORD=cuymonitor
# En RDS usar "require"; en local "disable"
DB_SSLMODE=disable
